source "https://rubygems.org"

# Use the same Jekyll version and supported plugins as GitHub Pages.
gem "github-pages", group: :jekyll_plugins
gem "webrick", "~> 1.8"

# Windows does not supply IANA timezone data.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
